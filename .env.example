NODE_ENV=production
PORT=8080
INTERNAL_SERVICE_SECRET=luxeva_internal_service_secret
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS allowance)
FRONTEND_URL=https://your-frontend-url.com

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ADMIN_EMAIL=admin@luxeva.com

# Database Connection (MongoDB Atlas connection string)
# You can use a single MONGO_URI for all services:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/luxeva?retryWrites=true&w=majority
# Or separate URIs per microservice if preferred:
AUTH_MONGO_URI=
CATALOG_MONGO_URI=
ORDER_MONGO_URI=
CONTENT_MONGO_URI=
NOTIFICATION_MONGO_URI=
PAYMENT_MONGO_URI=

# Redis Cache (Optional - in-memory fallback is active if omitted)
REDIS_URL=redis://localhost:6379

# Third-party Integrations
GOOGLE_CLIENT_ID=replace-with-google-client-id
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Email & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=support@luxeva.com
ADMIN_ALERT_EMAIL=admin@luxeva.com
ADMIN_ALERT_PHONE=919999999999

# Seed Controls
SEED_ON_START=false
SEED_FORCE=false
SEED_VERSION=2026-05-22
