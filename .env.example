NODE_ENV=development
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=7d
MONGO_URI=mongodb://localhost:27017/luxeva-auth
CATALOG_MONGO_URI=mongodb://localhost:27017/luxeva-catalog
ORDER_MONGO_URI=mongodb://localhost:27017/luxeva-order
CONTENT_MONGO_URI=mongodb://localhost:27017/luxeva-content
NOTIFICATION_MONGO_URI=mongodb://localhost:27017/luxeva-notifications
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=support@example.com
TWO_FACTOR_API_KEY=replace-with-2factor-key
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_ALERT_PHONE=919999999999
SEED_ON_START=false
SEED_FORCE=false
SEED_VERSION=2026-05-22
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_USE_PREVIEW_AUTH=false
